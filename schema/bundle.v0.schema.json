{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huygena/huygena-verify/main/schema/bundle.v0.schema.json",
  "title": "Huygena evidence bundle v0 (draft)",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "bundle.v0"
    },
    "algorithm": {
      "type": "string",
      "const": "sha256"
    },
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256:<64 lowercase hex>"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "sha256:<64 lowercase hex>"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ]
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "spec",
    "algorithm",
    "root",
    "files"
  ],
  "description": "Content-addressed evidence bundle. root is defined in SPEC.md."
}
