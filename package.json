{
  "name": "huygena-verify",
  "version": "0.1.0",
  "description": "Check a scientific replication without trusting anyone: validate run manifests, hash evidence bundles, catch edited files, recompute per-claim verdicts and re-check certificates. Offline. Library and CLI.",
  "license": "Apache-2.0",
  "homepage": "https://docs.huygena.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huygena/huygena-verify.git"
  },
  "bugs": {
    "url": "https://github.com/huygena/huygena-verify/issues"
  },
  "author": "Huygena",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "huygena-verify": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "SPEC.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "schema": "pnpm build && node scripts/gen-schema.mjs",
    "prepare": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup"
  },
  "keywords": [
    "huygena",
    "replication",
    "reproducibility",
    "science",
    "desci",
    "manifest",
    "content-addressed",
    "sha256",
    "certificate",
    "verification"
  ],
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@12.16.1"
}
